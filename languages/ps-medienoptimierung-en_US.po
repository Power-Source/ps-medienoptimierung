msgstr "Multisite control"

#: lib/class-ps-smush-admin.php:220
msgid "Lege fest, ob Netzwerkeinstellungen für alle Unterwebseiten gelten oder ob Unterwebseiten-Admins die Optimierungs-Einstellungen selbst steuern können."
msgstr "Choose whether network settings apply to all subsites or subsite administrators can manage optimization settings themselves."

#: lib/class-ps-smush-admin.php:223
msgid "Bilder beim Hochladen automatisch optimieren"
msgstr "Automatically optimize images on upload"

#: lib/class-ps-smush-admin.php:224
msgid "Automatische Optimierung"
msgstr "Automatic optimization"

#: lib/class-ps-smush-admin.php:225
msgid "Wenn du Bilder hochlädst, werden sie automatisch für dich optimiert."
msgstr "Images are automatically optimized when you upload them."

#: lib/class-ps-smush-admin.php:228
msgid "Super-Optimierung aktivieren"
msgstr "Enable Super-Smush"

#: lib/class-ps-smush-admin.php:229
#: lib/class-ps-smush-admin.php:387
#: lib/class-ps-smush.php:1076
